    ␛[2m│ ␛[0m␛[2mkind = "rules"                   # built in: a session's own `wf` commands␛[0m
    ␛[2m│␛[0m
    ␛[2m│ ␛[0m␛[2m[[permissions.decider]]␛[0m
    ␛[2m│ ␛[0m␛[2mkind = "model"                   # a decision model over the System One␛[0m
    ␛[2m│ ␛[0m␛[2mAPI, such as Jev␛[0m
    ␛[2m│ ␛[0m␛[2murl = "https://openrouter.ai/api/v1/systemone"␛[0m
    ␛[2m│ ␛[0m␛[2mmodel = "typesafe/jev-1.13"␛[0m
    ␛[2m│ ␛[0m␛[2mapi_key_env = "OPENROUTER_API_KEY"␛[0m
    ␛[2m│ ␛[0m␛[2mquestion = { noul = { allow_above = 0.95, deny_below = 0.05 } }   # or␛[0m
    ␛[2m│ ␛[0m␛[2m{ choice = { min_confidence = 0.8 } }␛[0m
    ␛[2m│␛[0m
    ␛[2m│ ␛[0m␛[2m[[permissions.decider]]␛[0m
